# Discord Developer Portal에서 발급한 Bot Token
DISCORD_TOKEN=replace_with_your_bot_token

# 개발 중 특정 서버에 명령어를 즉시 동기화하려면 서버 ID를 입력합니다.
# 비워두면 전역 명령어로 동기화되며 반영에 시간이 걸릴 수 있습니다.
DEV_GUILD_ID=

# Discord에서 보일 봇 사용자명과 서버 별명
BOT_DISPLAY_NAME=은하

# SQLite 데이터베이스 위치
DATABASE_PATH=data/bot.db

# 로그 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 환영 메시지/자동 역할 기능에 필요합니다.
ENABLE_MEMBER_INTENT=true

# 메시지 수정/삭제 로그에 필요합니다.
ENABLE_MESSAGE_CONTENT_INTENT=true

# 선택 기능: Gemini 기반 /인공지능 명령어. 비워두면 AI 기능만 비활성화됩니다.
# Google AI Studio에서 무료 API 키를 발급받아 입력하세요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1200

# 서버별 사용자 1명의 하루 AI 요청 제한. 0은 봇 내부 제한 해제입니다.
# 0으로 설정해도 Gemini 무료 등급의 모델/검색 쿼터는 그대로 적용됩니다.
AI_DAILY_USER_LIMIT=20
