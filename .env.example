# Discord Developer Portal에서 발급한 Bot Token
DISCORD_TOKEN=replace_with_your_bot_token

# 개발 중 특정 서버에 명령어를 즉시 동기화하려면 서버 ID를 입력합니다.
# 비워두면 전역 명령어로 동기화되며 반영에 시간이 걸릴 수 있습니다.
DEV_GUILD_ID=

# Discord에서 보일 봇 사용자명과 서버 별명
# 비워두면 Discord Developer Portal과 서버의 현재 이름을 그대로 유지합니다.
BOT_DISPLAY_NAME=Milkway Bot

# SQLite 데이터베이스 위치
DATABASE_PATH=data/bot.db

# 로그 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 환영 메시지/자동 역할 기능에 필요합니다.
ENABLE_MEMBER_INTENT=true

# 메시지 수정/삭제 로그에 필요합니다.
ENABLE_MESSAGE_CONTENT_INTENT=true

# AI 공급자: auto, groq, gemini
# auto는 GROQ_API_KEY가 있으면 Groq를 우선 사용하고, 없으면 Gemini를 사용합니다.
AI_PROVIDER=auto

# 권장 무료 공급자: Groq Cloud
# 일반 모델은 API 키에 실제로 열린 모델 중에서 자동 선택합니다.
# 검색은 무료 플랜에서 groq/compound-mini를 사용합니다.
GROQ_API_KEY=
GROQ_MODEL=auto
GROQ_SEARCH_MODEL=groq/compound-mini

# 선택적 보조 공급자: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=auto

# AI 공통 최대 출력 토큰 수
AI_MAX_OUTPUT_TOKENS=1200

# 서버별 사용자 1명의 하루 AI 요청 제한. 0은 봇 내부 제한 해제입니다.
# 0으로 설정해도 Groq/Gemini 무료 플랜의 분당·일일 한도는 그대로 적용됩니다.
AI_DAILY_USER_LIMIT=20
